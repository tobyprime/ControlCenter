# 敏感配置（不进 git、不进 issue）。复制为 secret.env（chmod 600）并填入真实值。
# 首次启动语义：账号仅用户表为空时创建；napcat 配置仅面板 KV 为空时种子写入。

# 面板初始账号
DEVICEPANEL__AUTH__INITIALUSERNAME=admin
DEVICEPANEL__AUTH__INITIALPASSWORD='请改成强密码'

# napcat OneBot HTTP（优先填集群内 Service 地址，如 http://napcat.webstack.svc.cluster.local:3000）
DEVICEPANEL__ALERT__NAPCAT__BASEURL='http://<napcat 地址>:3000'
DEVICEPANEL__ALERT__NAPCAT__TOKEN='<napcat token>'
DEVICEPANEL__ALERT__NAPCAT__TARGETTYPE=private
DEVICEPANEL__ALERT__NAPCAT__TARGETID='<QQ 号>'
