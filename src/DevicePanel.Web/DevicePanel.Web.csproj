<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DevicePanel.Web</RootNamespace>
    <AssemblyName>DevicePanel.Web</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 构建期产出 OpenAPI 文档（TOB-401）：dotnet build 即生成，全程不起服务端口；
         文件名 = 文档名 openapi.json（DocumentName 在 Program.cs 设置），落在 artifacts/openapi/ -->
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <!-- OpenAPI 文档源（net8.0 无 AddOpenApi/MapOpenApi，走 NSwag 构建期生成）；
         Microsoft.Extensions.ApiDescription.Server 负责把文档生成挂到 MSBuild -->
    <PackageReference Include="NSwag.AspNetCore" Version="14.4.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="8.0.14">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevicePanel.Protocol\DevicePanel.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Migrations\*.sql" />
    <InternalsVisibleTo Include="DevicePanel.Web.Tests" />
  </ItemGroup>

</Project>
